# Configuración de un entorno desplegado (dev o producción).
#
# Se copia a .env JUNTO al docker-compose.yml del servidor y se rellena.
# No se versiona: contiene secretos.
#
# Todas las variables son obligatorias. El compose usa ${VAR:?}, así que si
# falta alguna el despliegue aborta antes de tocar lo que está corriendo, en
# vez de arrancar un servicio con un valor vacío.

# ---------------------------------------------------------------------------
# Identidad del entorno
# ---------------------------------------------------------------------------
# Prefija contenedores, red y volúmenes. Es lo que permite que dev y
# producción convivan en la misma máquina sin pisarse.
COMPOSE_PROJECT_NAME=abako-dev
NODE_ENV=production

# ---------------------------------------------------------------------------
# Puertos en el host
# ---------------------------------------------------------------------------
# Solo se publican en 127.0.0.1; quien expone al exterior es nginx.
# Producción en esta misma máquina tendrá que usar otros (4100, 3100...).
ADAPTER_API_HOST_PORT=4000
VIRTO_API_HOST_PORT=3000
BRAMP_HOST_PORT=3001
CONTRACTS_API_HOST_PORT=3010
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# El usuario admin solo se usa al inicializar el volumen, para crear una base
# y un usuario por servicio. Los servicios entran con sus propias credenciales.
POSTGRES_ADMIN_USER=abako_admin
POSTGRES_ADMIN_PASSWORD=CAMBIAR-genera-uno-con-openssl-rand-base64-32

ADAPTER_DB_USER=abako_adapter
ADAPTER_DB_PASSWORD=CAMBIAR-genera-uno-con-openssl-rand-base64-32
ADAPTER_DB_NAME=abako_adapter

BRAMP_DB_USER=abako_bramp
BRAMP_DB_PASSWORD=CAMBIAR-genera-uno-con-openssl-rand-base64-32
BRAMP_DB_NAME=abako_bramp

# ---------------------------------------------------------------------------
# Cadena de bloques
# ---------------------------------------------------------------------------
# Gateway al que conectan los servicios desplegados. No hay cadena local:
# zombienet es herramienta de desarrollo (ADR-002, decisión 5).
# PENDIENTE: sustituir por el gateway que facilite el equipo de Virto.
PROVIDER_URL=wss://testnet.kreivo.kippu.rocks

# Cuenta que firma las transacciones. //Alice solo tiene fondos en una cadena
# de desarrollo: en una red real hay que poner una cuenta financiada.
CHAIN_PHRASE=
CHAIN_DERIVE_PATH=//Alice
BRAMP_MASTER_ACCOUNT_URI=//Alice

COMMUNITY_ID=1
PROJECTS_APP_ID=0
CALENDAR_APP_ID=1
RATINGS_APP_ID=2

# Direcciones de los contratos desplegados en esa cadena. Cambian cada vez que
# se redespliegan, por eso viven aquí y no en el compose (ADR-002, decisión 7).
# PENDIENTE: valores reales cuando los contratos estén en la testnet.
DEFAULT_CALENDAR_CONTRACT=Dd34LSU53MLwJpq4wfHmDFwAifJrcaPbd1qTCGZcR7iXQkd
DEFAULT_RATINGS_CONTRACT=JEnwSomCEqPrh5HcEzPFNKVfrfoFjVLR6JVJvqKaTfba4zY
DAO_ADDRESS=

# ---------------------------------------------------------------------------
# VOS (identidad)
# ---------------------------------------------------------------------------
# Hoy apunta al virto-api local, que sirve vos-mock. Cuando el equipo dé la
# dirección del VOS real, se cambia esta línea y se redespliega.
FEDERATE_SERVER=http://virto-api:3000/api

# Nombre que ve el usuario en el diálogo de passkey del navegador.
RP_NAME=ABAKO

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Origen EXACTO del frontend desplegado, sin barra final y sin comodines: el
# stream SSE de notificaciones usa cookies con credenciales.
CORS_ORIGIN=https://web.dev.abako.xyz

# Host público por el que se llega a este backend.
PUBLIC_HOST=dev.abako.xyz

# Firma de los JWT. Genera uno propio por entorno:
#   openssl rand -base64 48
JWT_SECRET=CAMBIAR-genera-uno-con-openssl-rand-base64-48
JWT_EXPIRES_IN=24h
