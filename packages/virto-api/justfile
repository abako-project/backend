default:
    @just --list

install:
    pnpm install --frozen-lockfile

build:
    pnpm run build

dev:
    SEED="//Alice" PORT=3000 NODE_ENV=development pnpm run start:dev

start:
    SEED="//Alice" PORT=3000 NODE_ENV=production pnpm run start:prod

test-unit:
    pnpm run test:unit

test-integration:
    pnpm run test:integration

test-e2e:
    SEED="//Alice" PORT=3000 NODE_ENV=test pnpm run test:e2e
