# Adapter-API config for use with mock-api (no blockchain required)
#
# Quick start:
#   Terminal 1: pnpm run mock
#   Terminal 2: pnpm run dev:mock
PORT=4000
NODE_ENV=development

# Point both services at mock-api (default port 4010)
SIGNING_SERVICE_URL=http://localhost:4010
FEDERATE_SERVER=http://localhost:4010/api

# SQLite database path (created automatically)
SQLITE_PATH=./data/abako.sqlite

# Not needed with mock-api but required by the SDK initialization
PROVIDER_URL=wss://testnet.kreivo.kippu.rocks

JWT_SECRET=virto-server-example-secret-key-change-in-production
JWT_EXPIRES_IN=10m
